# Nach /etc/physio.env kopieren (Besitzer root, Rechte 600) und die <...> ersetzen. Niemals ins Repository.
PHYSIO_SECRET_KEY=<Ausgabe von: openssl rand -hex 32>
PHYSIO_ALLOWED_HOSTS=physio.rendl.at,127.0.0.1
PHYSIO_TRUST_PROXY=1
PHYSIO_DATA_DIR=/home/pi/physio-data
PHYSIO_KEYFILE=/home/pi/physio-data/master.sealed
PHYSIO_JOB_TOKEN=<Ausgabe von: openssl rand -hex 32>
# Mailserver der Praxis (optional; jeder Therapeut kann in den Einstellungen einen eigenen hinterlegen):
# PHYSIO_EMAIL_HOST=
# PHYSIO_EMAIL_PORT=587
# PHYSIO_EMAIL_USER=
# PHYSIO_EMAIL_PASSWORD=
# PHYSIO_FROM_EMAIL=
